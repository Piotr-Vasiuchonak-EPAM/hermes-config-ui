# Copy to .env and edit. docker compose reads this file.

# Public host name. nginx-proxy routes it to the container (VIRTUAL_HOST). Required.
HCUI_HOST=hermes-config.example.com

# Host folders. The defaults are under $HOME.
# HCUI_HERMES_DATA=$HOME/hermes/data
# HCUI_HISTORY=$HOME/.local/share/hermes-config-ui/history
# HCUI_RUN=$HOME/.local/share/hermes-config-ui/run
